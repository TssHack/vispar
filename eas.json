{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "android": { "buildType": "apk" }
    },
    "development_tv": {
      "extends": "development",
      "env": { "EXPO_TV": "1" }
    },
    "production_tv": {
      "extends": "production",
      "env": { "EXPO_TV": "1" }
    }
  },
  "submit": {}
}
