# Recommended: point the app at the proxy in /proxy (key stays on the server; required for web).
EXPO_PUBLIC_API_BASE=https://vispar-api.<your-subdomain>.workers.dev

# Direct mode (native only, key is embedded in the app like the current Android build):
# EXPO_PUBLIC_API_BASE=https://hostinnegar.com/api
# EXPO_PUBLIC_API_KEY=your-key
