# The app already points at the hosted proxy, so this file is optional.
# Override it to use your own proxy (the key stays on the server, and the web build needs CORS):
# EXPO_PUBLIC_API_BASE=https://your-proxy.example.com/api

# Direct mode (native only, the key is embedded in the app and visible to anyone with the APK):
# EXPO_PUBLIC_API_BASE=https://hostinnegar.com/api
# EXPO_PUBLIC_API_KEY=your-key
