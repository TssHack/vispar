    "@types/react": "~19.3.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:tv": "EXPO_TV=1 expo start",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "build:web": "expo export -p web && node scripts/pwa-postbuild.js",
    "brand:pwa": "node scripts/build-pwa-icons.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brand:icons": "node scripts/build-icons.js"
  },
  "private": true,
  "description": "Vispar — cross-platform movie & series app (Android, iOS, Web, Android TV)",
