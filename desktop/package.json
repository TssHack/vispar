{
  "name": "vispar-desktop",
  "version": "2.5.1",
  "private": true,
  "description": "Vispar desktop app (Windows, macOS, Linux)",
  "desktopName": "vispar-desktop.desktop",
  "author": "Ehsan Fazli <https://ehsanfazli.ir>",
  "homepage": "https://ehsanfazli.ir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsshack/vispar"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.fazli.vispar",
    "productName": "Vispar",
    "copyright": "Ehsan Fazli",
    "electronLanguages": ["fa", "en-US"],
    "directories": { "output": "../release", "buildResources": "build" },
    "files": ["main.js", "package.json", "build/icon.png"],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": ["**/*", "!movie/**", "!series/**", "!movies/**", "!app.html", "!sitemap.xml", "!robots.txt", "!og.png"]
      }
    ],
    "artifactName": "Vispar-${version}-${os}-${arch}.${ext}",
    "win": { "target": ["nsis", "portable"],
      "artifactName": "Vispar-${version}-win-${arch}.${ext}", "icon": "build/icon.png" },
    "portable": { "artifactName": "Vispar-${version}-win-portable.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg", "zip"], "icon": "build/icon.png", "category": "public.app-category.entertainment" },
    "linux": {
      "target": ["AppImage", "deb", "rpm", "pacman"],
      "icon": "build/icons",
      "syncDesktopName": true,
      "category": "AudioVideo",
      "maintainer": "Ehsan Fazli <ehsanfazlinejad@gmail.com>",
      "synopsis": "Movies and series"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "rpm": {
      "fpm": ["--rpm-rpmbuild-define", "_build_id_links none"],
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib"
      ]
    },
    "pacman": {
      "fpm": ["--description", "Vispar: movies and series"],
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "at-spi2-core",
        "util-linux-libs",
        "libsecret",
        "mesa",
        "xdg-utils"
      ]
    }
  }
}
