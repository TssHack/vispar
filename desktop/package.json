{
  "name": "vispar-desktop",
  "version": "2.1.0",
  "private": true,
  "description": "Vispar desktop app (Windows, macOS, Linux)",
  "author": "Ehsan Fazli <https://ehsanjs.ir>",
  "homepage": "https://ehsanjs.ir",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.fazli.vispar",
    "productName": "Vispar",
    "copyright": "Ehsan Fazli",
    "directories": { "output": "../release", "buildResources": "build" },
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../dist", "to": "web" }],
    "artifactName": "Vispar-${version}-${os}-${arch}.${ext}",
    "win": { "target": ["nsis", "portable"],
      "artifactName": "Vispar-${version}-win-${arch}.${ext}", "icon": "build/icon.png" },
    "portable": { "artifactName": "Vispar-${version}-win-portable.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg", "zip"], "icon": "build/icon.png", "category": "public.app-category.entertainment" },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Ehsan Fazli <ehsanfazlinejad@gmail.com>",
      "synopsis": "Movies and series"
    }
  }
}
